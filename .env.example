# ==============================================================================
# TravelRescue (Train-Help) Environment Variables Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Fill in real values in .env.local.
# 3. NEVER commit .env.local or any real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------

# [REQUIRED IN PRODUCTION] Supabase project REST API endpoint URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# [REQUIRED IN PRODUCTION] Supabase anonymous client API key (safe for browser with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [OPTIONAL / RECOMMENDED IN PRODUCTION] Canonical public web application URL (used for AI HTTP-Referer headers)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY VARIABLES (Application runtime / API routes - NEVER expose to browser)
# ------------------------------------------------------------------------------

# [REQUIRED IN PRODUCTION] Redis connection URL for distributed sliding-window rate limiting.
# If REDIS_URL is missing, rate limits fall back to per-instance memory; if set but unreachable, requests fail closed (HTTP 503).
# Format: redis://username:password@host:port or rediss://...
REDIS_URL=

# [SERVER-ONLY] Node runtime environment (development | test | production)
NODE_ENV=development

# [SERVER-ONLY] Supabase server-side overrides (optional; defaults to NEXT_PUBLIC_* equivalents)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI Assistant Configuration (Server-Only) ---
# Supported providers: groq | openrouter | nvidia | deepseek | mock
# All AI credentials are strictly server-only and must never be exposed to the client.
AI_PROVIDER=groq
AI_API_KEY=

# Optional model override (defaults per provider):
# Groq: llama-3.3-70b-versatile or mixtral-8x7b-32768
# OpenRouter: meta-llama/llama-3.3-70b-instruct
# NVIDIA NIM: meta/llama-3.3-70b-instruct
# DeepSeek: deepseek-chat
AI_MODEL=llama-3.3-70b-versatile

# Optional custom base URL (overrides default provider endpoints)
AI_BASE_URL=

# Legacy / Direct DeepSeek provider configuration (Server-Only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# ------------------------------------------------------------------------------
# 3. LOCAL-SCRIPTS-ONLY VARIABLES (Seed and migration tools - NEVER in production)
# ------------------------------------------------------------------------------

# [LOCAL SCRIPTS ONLY] Supabase service role key (bypasses Row Level Security).
# LOCAL seed/migration scripts only. NEVER set in Vercel or any hosting dashboard. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# [LOCAL SCRIPTS ONLY] Direct PostgreSQL database connection URL for schema migrations and psql.
# NEVER set in hosting dashboards or public environments.
# Format: postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
